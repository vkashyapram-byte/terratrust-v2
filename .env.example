# Copy this file to .env and replace every placeholder with values from your
# Supabase project settings. Never commit .env or server-only secrets.

# Public browser configuration. These values are safe to expose to the client;
# protect your data with Supabase Row Level Security policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side configuration. Do not prefix secrets with VITE_ and never expose
# the service-role key in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# Optional Supabase project details used by local tooling or integrations.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_SITE_URL=http://localhost:3000

# Optional: point at your n8n webhook to switch Live Verification from demo to live mode.
# VITE_N8N_WEBHOOK_URL=https://your-n8n-host/webhook/terratrust/verify
